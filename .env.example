# Copia este archivo como .env y ajusta los valores. Nunca subas .env al repositorio.
SECRET_KEY=cambia-esta-clave-por-una-larga-y-aleatoria
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
# Local: sqlite:///db.sqlite3
# Supabase: postgresql://postgres:<password>@db.<proyecto>.supabase.co:5432/postgres
DATABASE_URL=postgresql://postgres:password@localhost:5432/parqueadero

# Contraseñas de los usuarios de prueba que crea `python manage.py seed`.
# Solo para desarrollo; cámbialas en tu .env si quieres.
SEED_ADMIN_PASSWORD=Admin2026!
SEED_GUARDA_PASSWORD=Guarda2026!
SEED_CONDUCTOR_PASSWORD=Conductor2026!

# Llave AES-256 del token QR dinámico: 32 bytes aleatorios en base64url.
# Genera la tuya con:
#   python -c "import base64, secrets; print(base64.urlsafe_b64encode(secrets.token_bytes(32)).decode())"
QR_SECRET_KEY=genera-una-llave-con-el-comando-de-arriba
